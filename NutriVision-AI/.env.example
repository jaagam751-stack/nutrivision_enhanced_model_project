# =============================================================================
# NutriVision AI — environment variables (LOCAL DEVELOPMENT ONLY)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file: it is listed in .gitignore.
# On Streamlit Community Cloud, add the same keys in
#   App → Settings → Secrets (TOML format, see "Secrets" in README.md).
# =============================================================================

# --- Phase 2: Neon PostgreSQL ------------------------------------------------
# Copy the connection string from your Neon project dashboard
# (Dashboard → Connect → "Connection string"). The application also accepts the
# plain `postgres://` and `postgresql://` forms; they are rewritten to use the
# psycopg2 driver automatically.
#
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=

# --- Phase 2 (optional): local SQLite development fallback -------------------
# Only if you do NOT have a Neon account yet. Development/preview use only —
# Streamlit Community Cloud has an ephemeral filesystem, so deployment needs
# PostgreSQL. Uncomment to enable:
#
#   DATABASE_URL=sqlite:///nutrivision.db
#
# You can also switch to it for a single run without editing this file:
#   python database/init_db.py --sqlite
#   (then set it in the app via the "Use SQLite for this session" button)

# --- Phase 7: Google Gemini 2.5 Flash ---------------------------------------
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Optional application settings -------------------------------------------
# Log level for the console logger: INFO, WARNING, or ERROR
LOG_LEVEL=INFO
